# Только для локальной демонстрации: замените учётные данные в .env.
# PostgreSQL
POSTGRES_DB=format_security
POSTGRES_USER=format_security
POSTGRES_PASSWORD=change-me-postgres

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ENDPOINT=http://minio:9000
MINIO_SECURE=false

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=format-security-admin

# Internal service URLs (Docker network)
INSPECTOR_URL=http://inspector:8081
VALIDATOR_URL=http://validator:8082
STORAGE_URL=http://storage:8083
AUDIT_URL=http://audit:8084
GATEWAY_HEALTH_URL=http://localhost:8080/health
MINIO_HEALTH_URL=http://minio:9000/minio/health/live
PROMETHEUS_HEALTH_URL=http://prometheus:9090/-/healthy
GRAFANA_HEALTH_URL=http://grafana:3000/api/health

# Upload and downstream limits
MAX_UPLOAD_SIZE_BYTES=10485760
DOWNSTREAM_TIMEOUT_SECONDS=10
